---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import montserratFontUrl from "../assets/fonts/montserrat-latin.woff2?url";
import { pageTransition } from "../lib/pageTransition.js";
import "../style.css";

// Must not live in style.css: global CSS is inlined per page and swapped on
// navigation, which re-registers the font and flashes the fallback.
const fontFaceCss = `
@font-face {
  font-family: "Montserrat";
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url("${montserratFontUrl}") format("woff2");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: "Montserrat Fallback";
  src: local("Arial"), local("ArialMT"), local("Liberation Sans");
  size-adjust: 103.3%;
  ascent-override: 93.7%;
  descent-override: 24.3%;
  line-gap-override: 0%;
}`;

const {
  title,
  description,
  canonical,
  person,
} = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "DevTw.in",
  url: canonical,
  logo: "https://devtw.in/logo.jpg",
};
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link
      rel="preload"
      href={montserratFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline data-astro-transition-persist="font-faces" set:html={fontFaceCss}></style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DevTw.in" />
    <meta property="og:title" content="DevTw.in – Parham & Parsa Saeednia" />
    <meta
      property="og:description"
      content="Backend + Frontend devs crafting fast, clean web experiences."
    />
    <meta property="og:image" content="/logo.jpg" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="DevTw.in – Parham & Parsa Saeednia" />
    <meta
      name="twitter:description"
      content="Backend + Frontend devs crafting fast, clean web experiences."
    />
    <meta name="twitter:image" content="/logo.jpg" />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {person && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <ClientRouter />
  </head>
  <body>
    <Navbar currentPath={Astro.url.pathname} />
    <div class="page" transition:name="page" transition:animate={pageTransition}>
      <slot />
    </div>
  </body>
</html>
