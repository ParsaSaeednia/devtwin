---
const { currentPath } = Astro.props;
const normalizedPath = currentPath.replace(/\/$/, "") || "/";
const isParham = normalizedPath === "/Parham";
const isParsa = normalizedPath === "/Parsa";
---

<nav class="site-nav" transition:name="site-nav" transition:animate="none">
  <div class="container nav-inner">
    <a
      class:list={[
        "parham-container",
        { "is-active": isParham },
      ]}
      href="/Parham"
      aria-current={isParham ? "page" : undefined}
    >
      <div>
        <span class="nav-title">Parham</span>
        <span class="nav-sub parham-hover-line">Go through</span>
      </div>
    </a>

    <a
      class:list={[
        "parsa-container",
        { "is-active": isParsa },
      ]}
      href="/Parsa"
      aria-current={isParsa ? "page" : undefined}
    >
      <div>
        <span class="nav-title">Parsa</span>
        <span class="nav-sub parsa-hover-line">Go through</span>
      </div>
    </a>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 9;
    background: linear-gradient(to bottom, var(--paper-bg) 60%, transparent);
    border-bottom: 2px dashed #212121;
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    padding-block: clamp(16px, 1vw, 32px);
  }

  .parham-container,
  .parsa-container {
    position: relative;
    overflow: hidden;
  }

  .nav-title {
    font-size: clamp(24px, 6vw, 68px);
    font-weight: 200;
    line-height: 1.1;
    color: #606060;
    display: block;
    transition:
      color 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-sub {
    font-size: clamp(12px, 2.2vw, 16px);
    font-weight: 300;
    line-height: 1.2;
    display: block;
    color: #606060;
    transition:
      color 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      padding-left 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease;
  }

  .parham-container:hover .nav-title,
  .parham-container:hover .nav-sub {
    color: #212121;
    cursor: pointer;
  }

  .parham-container:hover .nav-title {
    transform: translateX(4px);
  }

  .parham-hover-line {
    position: relative;
    padding-left: 0;
  }

  .parham-hover-line::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: 6px;
    width: 0%;
    height: 2px;
    background-color: #212121;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .parham-container:hover .parham-hover-line::before {
    width: 50%;
  }

  .parham-container:hover .parham-hover-line {
    padding-left: clamp(4em, 12vw, 11.5em);
  }

  .parsa-container:hover .nav-title,
  .parsa-container:hover .nav-sub {
    color: #212121;
    cursor: pointer;
  }

  .parsa-container:hover .nav-title {
    transform: translateX(-4px);
  }

  .parsa-hover-line {
    position: relative;
    padding-left: 0;
  }

  .parsa-hover-line::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: 6px;
    width: 0%;
    height: 2px;
    background-color: #212121;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .parsa-container:hover .parsa-hover-line::before {
    width: 45%;
  }

  .parsa-container:hover .parsa-hover-line {
    padding-left: clamp(3em, 8vw, 7.1em);
  }

  .is-active .nav-title {
    color: #212121;
  }

  .is-active .nav-sub {
    opacity: 0;
    pointer-events: none;
  }

  @media screen and (max-width: 1024px) {
    .nav-title,
    .nav-sub {
      transition: color 0.3s ease;
    }

    .parham-container:hover .nav-title,
    .parsa-container:hover .nav-title {
      transform: none;
    }

    .parham-hover-line::before,
    .parsa-hover-line::before {
      display: none;
    }

    .parham-container:hover .parham-hover-line,
    .parsa-container:hover .parsa-hover-line {
      padding-left: 0;
    }

    .nav-sub {
      font-size: clamp(10px, 2vw, 14px);
    }
  }

  @media screen and (max-width: 480px) {
    .nav-title {
      font-size: clamp(20px, 8vw, 32px);
    }

    .nav-sub {
      display: none;
    }
  }
</style>
